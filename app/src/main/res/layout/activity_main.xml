<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="StudyBuddy App Logo"
            android:src="@drawable/studybuddyapplogo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Study Together, Achieve More!"
            android:textSize="13sp"
            android:textColor="#666666"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnJoinGroups"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_button_bg_light_green"
            app:backgroundTint="@color/light_green"
            android:text="JOIN GROUPS"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/join_group"
            app:iconTint="#000000"
            app:iconPadding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_button_bg_light_green"
            app:backgroundTint="@color/light_green"
            android:text="CREATE GROUP"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/join_group"
            app:iconTint="#000000"
            app:iconPadding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnStatistics"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_button_bg_light_green"
            app:backgroundTint="@color/light_green"
            android:text="STATISTICS"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/statistics"
            app:iconTint="#000000"
            app:iconPadding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnAddPost"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/rounded_button_bg_light_green"
            app:backgroundTint="@color/light_green"
            android:text="ADD POST"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/add_post"
            app:iconTint="#000000"
            app:iconPadding="12dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnActivities"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/rounded_button_bg_light_green"
            app:backgroundTint="@color/light_green"
            android:text="ACTIVITIES"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/statistics"
            app:iconTint="#000000"
            app:iconPadding="12dp"
            android:gravity="center" />

    </LinearLayout>


    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation_bar" />

    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/dark_green"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/nav_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/notifications"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/nav_groups"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/groups"
            app:tint="@color/black"/>

        <ImageButton
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/profile"
            app:tint="@color/black" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>