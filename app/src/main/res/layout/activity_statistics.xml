<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_gray"
        android:src="@drawable/outline_arrow_back_ios_24"
        android:paddingStart="10dp"
        app:tint="#333333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statistics"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layout_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_gray_card"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:gravity="center">
            <TextView android:id="@+id/tvTotalHours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0h" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Hour" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_gray_card"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:gravity="center">
            <TextView android:id="@+id/tvActiveGroups" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active Groups" android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_gray_card"
            android:padding="12dp"
            android:layout_margin="4dp"
            android:gravity="center">
            <TextView android:id="@+id/tvStreak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17day" android:textStyle="bold" android:textSize="18sp" android:textColor="#000000"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Streak" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvWeeklyGoalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weekly Goal"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/layout_cards"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvWeeklyGoalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 / 25 hours"
        android:textSize="12sp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvWeeklyGoalTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <SeekBar
        android:id="@+id/seekBarWeeklyGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:max="100"
        android:progress="25"
        android:progressDrawable="@drawable/custom_seekbar"
        app:layout_constraintTop_toBottomOf="@id/tvWeeklyGoalText" />

    <com.github.mikephil.charting.charts.BarChart
        android:id="@+id/barChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/seekBarWeeklyGoal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>